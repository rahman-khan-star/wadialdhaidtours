# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server-only: never expose with a NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin authentication (required in production, 32+ chars)
JWT_SECRET=generate-a-long-random-secret-here
ADMIN_USERNAME=admin
# Prefer a pre-computed bcrypt hash; plain password is hashed at startup if set
ADMIN_PASSWORD_HASH=$2a$10$replace-with-bcrypt-hash
# ADMIN_PASSWORD=your-strong-admin-password

# Flights (server-only)
# Flight provider: "mock" (synthetic inventory), or the real Ignav API via
# "ignav" (aliases: "real", "live"). Set this in Vercel Production — if it is
# left unset, a configured IGNAV_API_KEY still selects the real provider.
# Switching providers never touches the search UI.
FLIGHT_PROVIDER=mock
# Ignav API key (https://ignav.com/docs). The only credential the flight
# provider reads: sent as the X-Api-Key header of server-side fare requests and
# never referenced by client code. FLIGHT_SEARCH_SECRET is NOT used as a key.
# When the real provider is selected but this is missing, search returns
# "search unavailable" — it never falls back to mock inventory.
# IGNAV_API_KEY=your-ignav-api-key
# Signs the short-lived search token that binds an inquiry to a real search.
# Dedicated random 32+ char secret, kept separate from IGNAV_API_KEY.
# Optional: falls back to JWT_SECRET (32+ chars required in production).
# Rotating it invalidates in-flight search tokens (they expire after 30 minutes).
# FLIGHT_SEARCH_SECRET=generate-another-long-random-secret-here
